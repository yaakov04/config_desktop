# Añadidos propios al .bashrc de la distro.
# Lo carga install.sh con un `source` al final de ~/.bashrc,
# así el .bashrc stock de Ubuntu queda intacto.

# nvm (Node Version Manager)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# PATH
export PATH="/usr/sbin:$PATH"

# rust / cargo
# . "$HOME/.cargo/env"

# pnpm en lugar de npm
alias npm=pnpm

# Prompt (debe ir al final)
eval "$(starship init bash)"
